FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm ci
COPY . .
RUN npm run build --workspace=@mile-triage/shared \
  && npm run build --workspace=@mile-triage/web

FROM nginx:1.27-alpine
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/set-api-proxy-host.sh /docker-entrypoint.d/05-set-api-proxy-host.sh
RUN chmod +x /docker-entrypoint.d/05-set-api-proxy-host.sh
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
ENV PORT=80
ENV API_UPSTREAM=https://mile-triage-production.up.railway.app
EXPOSE 80
