# Database
DATABASE_URL="postgresql://miletriage:miletriage@localhost:5432/miletriage?schema=public"

# API
PORT=3001
WEB_ORIGIN="http://localhost:5173"
SESSION_SECRET="replace-with-long-random-string"
TOKEN_ENCRYPTION_KEY="replace-with-64-hex-chars-or-32-byte-base64"
INTERNAL_TELEMETRY_SECRET="replace-with-shared-secret-for-ingest"
AUTH_MODE="mock"

# Tesla Fleet API (required when AUTH_MODE=tesla)
TESLA_CLIENT_ID=""
TESLA_CLIENT_SECRET=""
# Deployed value is https://YOUR_DOMAIN/api/auth/tesla/callback (web proxies /api)
TESLA_REDIRECT_URI="http://localhost:3001/auth/tesla/callback"
TESLA_AUTH_URL="https://auth.tesla.com/oauth2/v3/authorize"
TESLA_TOKEN_URL="https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token"
TESLA_API_BASE="https://fleet-api.prd.na.vn.cloud.tesla.com"
TESLA_AUDIENCE="https://fleet-api.prd.na.vn.cloud.tesla.com"
TESLA_SCOPES="openid offline_access user_data vehicle_device_data vehicle_location"
# Park-based drive detection. Polls vehicle_data and records a drive when the
# odometer has advanced between two parked sightings. Never wakes a sleeping car.
# Set to "false" to disable.
TESLA_POLLING_ENABLED="true"
# Bare hostname, no scheme. Root domain must match allowed_origins on developer.tesla.com
TESLA_DOMAIN="localhost"
TESLA_PUBLIC_KEY_PATH=""
# Hosted deploys: paste keys/public-key.pem contents here instead of using a file
TESLA_PUBLIC_KEY_PEM=""

# Defaults
DEFAULT_MILEAGE_RATE="0.70"
